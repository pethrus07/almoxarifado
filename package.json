{
  "name": "almoxarifado",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Almoxarifado de obra — controle de estoque por QR Code. Cloudflare Worker + D1 + R2.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "banco:local": "wrangler d1 execute almoxarifado --local --file=schema.sql",
    "seed:local": "wrangler d1 execute almoxarifado --local --file=seed-demo.sql",
    "recarregar": "npm run banco:local && npm run seed:local",
    "seed": "node ferramentas/gerar-seed.mjs > seed-demo.sql",
    "verificar": "node test/sintaxe.mjs",
    "test": "node test/qr.test.mjs",
    "test:api": "node test/api.mjs",
    "test:visual": "node test/visual.mjs",
    "test:tudo": "npm run verificar && npm test && npm run test:api && npm run test:visual"
  },
  "devDependencies": {
    "jsqr": "^1.4.0",
    "playwright": "^1.62.1",
    "qrcode": "^1.5.4",
    "wrangler": "^4.118.0"
  }
}
